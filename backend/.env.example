# ── Render Build & Start ──────────────────────────────────────
# Render auto-detects Node.js and runs these scripts
# Build: npm install && npm run build
# Start: npm start

# ── Database ────────────────────────────────────────────────────
# For local: uses SQLite (file-based, zero config)
# For Render: set DATABASE_URL to use PostgreSQL
DATABASE_URL=

# ── Required ────────────────────────────────────────────────────
PORT=4000
JWT_SECRET=replace-with-a-random-64-char-string-in-production

# ── GitHub Integration ──────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# ── AI ──────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ── Slack ───────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Customer DB (optional - for db-inspector) ───────────────────
CUSTOMER_DB_HOST=
CUSTOMER_DB_PORT=5432
CUSTOMER_DB_NAME=
CUSTOMER_DB_USER=
CUSTOMER_DB_PASS=
